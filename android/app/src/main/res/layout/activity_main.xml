<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alpha="0.75"
            android:text="@string/tagline"
            android:textSize="15sp" />

        <!-- ── Setup: three steps, each with a live ✓ ───────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/step_key"
                style="@style/Step"
                android:text="@string/step_key" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/api_key"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/api_key_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />
            </LinearLayout>

            <TextView
                android:id="@+id/key_help"
                style="@style/Hint"
                android:autoLink="web"
                android:text="@string/key_help" />

            <TextView
                android:id="@+id/step_screen"
                style="@style/Step"
                android:layout_marginTop="18dp"
                android:text="@string/step_screen" />

            <TextView
                style="@style/Hint"
                android:text="@string/screen_how" />

            <Button
                android:id="@+id/screen_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/screen_open_settings" />

            <TextView
                android:id="@+id/screen_restricted"
                style="@style/Hint"
                android:text="@string/screen_restricted" />

            <TextView
                android:id="@+id/step_try"
                style="@style/Step"
                android:layout_marginTop="18dp"
                android:text="@string/step_try" />

            <TextView
                style="@style/Hint"
                android:text="@string/try_how" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_demo"
                android:lineSpacingExtra="6dp"
                android:padding="14dp"
                android:text="@string/demo_text"
                android:textIsSelectable="true"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ── Settings ──────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="@string/model_label" />

            <Spinner
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Label"
                android:text="@string/target_label" />

            <Spinner
                android:id="@+id/target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Switch
                android:id="@+id/bubble"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bubble_switch" />

            <Switch
                android:id="@+id/zh_study"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/zh_study" />

            <Button
                android:id="@+id/test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/test" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="14dp"
            android:text="@string/how_to" />
    </LinearLayout>
</ScrollView>
