<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TransSnip" parent="android:Theme.Material">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
    </style>
    <style name="Theme.TransSnip.Popup" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_popup</item>
        <item name="android:windowElevation">12dp</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
