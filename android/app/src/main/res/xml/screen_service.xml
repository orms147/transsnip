<?xml version="1.0" encoding="utf-8"?>
<!-- The service reads the window tree only while translations are on (bubble /
     tile tapped). Events are used only then: scroll / click / app switch →
     refresh or close the translations. Gestures = replaying a swipe made in
     look-up mode. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled|typeViewClicked|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/screen_service_desc"
    android:notificationTimeout="100" />
